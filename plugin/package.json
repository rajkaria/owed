{
  "name": "owed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": "11.11.0"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "tsx src/plugin.ts",
    "build": "esbuild src/plugin.ts --bundle --platform=node --format=esm --target=node24 --main-fields=module,main --minify --banner:js=\"import{createRequire as __owedCreateRequire}from'node:module';const require=__owedCreateRequire(import.meta.url);import{fileURLToPath as __owedFileURLToPath}from'node:url';const __filename=__owedFileURLToPath(import.meta.url);const __dirname=__owedFileURLToPath(new URL('.',import.meta.url));process.noDeprecation=true;\" --outfile=dist/plugin.mjs",
    "conformance": "node scripts/conformance.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "unit": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
